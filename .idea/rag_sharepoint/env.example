# ── SharePoint / Azure App Registration ─────────────────────────────────────
# Crear en: https://portal.azure.com → Azure Active Directory → App Registrations
SP_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SP_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SP_CLIENT_SECRET=tu_secreto_aqui

# URL del site de SharePoint que quieres sincronizar
SP_SITE_URL=https://tuempresa.sharepoint.com/sites/taller

# ── Open WebUI ────────────────────────────────────────────────────────────────
# API Key: en Open WebUI → Settings → Account → API Keys
OWUI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ID de la Knowledge Base: en Open WebUI → Workspace → Knowledge → (tu KB) → URL
# La URL tendrá algo como /workspace/knowledge/abc123def456 → el ID es abc123def456
OWUI_KNOWLEDGE_ID=abc123def456

# ── Sincronización ────────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=60
